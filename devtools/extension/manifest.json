{
  "manifest_version": 3,
  "name": "Stellar Hooks DevTools",
  "version": "1.0.0",
  "description": "Inspect active stellar-hooks instances, query states, and transactions in a React DevTools-style panel.",
  "devtools_page": "devtools.html",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
